{
  "start": {
    "command": "scan_start",
    "payload": { "roots": ["/nonexistent/filesweep-example"], "includeHidden": false }
  },
  "pause": { "command": "scan_pause", "payload": {} },
  "resume": { "command": "scan_resume", "payload": {} },
  "cancel": { "command": "scan_cancel", "payload": {} },
  "status": { "command": "scan_status", "payload": {} },
  "groups": {
    "command": "scan_groups",
    "payload": { "scanId": 1, "query": { "offset": 0, "limit": 50, "sort": "savings" } }
  },
  "skipped": {
    "command": "scan_skipped",
    "payload": { "scanId": 1, "query": { "offset": 0, "limit": 200 } }
  },
  "history": {
    "command": "scan_history",
    "payload": { "scanId": 1, "query": { "edgesMs": [1577836800000, 1609459200000] } }
  },
  "filesUsed": {
    "command": "scan_files_used",
    "payload": { "scanId": 1, "query": { "beforeMs": 1609459200000, "offset": 0, "limit": 50 } }
  },
  "suggestedRoots": { "command": "suggested_roots", "payload": {} },
  "reveal": {
    "command": "reveal_file",
    "payload": { "scanId": 1, "groupId": 2, "fileId": 3 }
  },
  "revealIndexed": {
    "command": "reveal_indexed_file",
    "payload": { "scanId": 1, "fileId": 3 }
  }
}
